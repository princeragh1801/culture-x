# ---- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ---- Database (matches docker-compose.yml at the repo root) ------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=culturex
DB_PASSWORD=culturex
DB_NAME=culturex_dev
DB_NAME_TEST=culturex_test
DB_LOGGING=false

# ---- Auth -------------------------------------------------------------------
# Any random string of 16+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- Stripe (Test Mode) ------------------------------------------------------
# Dashboard -> Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=sk_test_xxx
# Printed by: stripe listen --forward-to localhost:4000/api/webhooks/stripe
# This is the CLI's signing secret and differs from a Dashboard endpoint secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PAYMENT_CURRENCY=inr
